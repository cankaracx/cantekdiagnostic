# Optional server-side provider credentials. The protected admin panel can
# also validate and store these credentials. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Embeddings (OpenAI). Keyword search still works without this.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536

ANTHROPIC_CHAT_MODEL=claude-sonnet-5
OPENAI_CHAT_MODEL=gpt-4o
GOOGLE_CHAT_MODEL=gemini-2.5-flash
XAI_CHAT_MODEL=grok-3-mini
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
MISTRAL_CHAT_MODEL=mistral-small-latest
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# Server-side abuse and cost controls
PUBLIC_CHAT_DAILY_LIMIT=1000
CHAT_MAX_CONCURRENCY=20
RATE_LIMIT_SALT=

# Authentication and document storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPER_ADMIN_EMAIL=
